# ShellCracker configuration (example values — safe defaults for a local lab)
# Copy to config.yaml and adjust for your lab network.

msfrpc:
  host: 127.0.0.1
  port: 55553
  user: msf
  password: msf        # CHANGE THIS — must match the password you start msfrpcd with
  ssl: true            # msfrpcd enables SSL by default

handler:
  # LHOST is YOUR attacking machine's IP on the lab network (the interface
  # facing the target), NOT the target. Leave as "auto" to let ShellCracker
  # detect it automatically from the route to the target; override with a
  # fixed IP only if auto-detection picks the wrong interface.
  lhost: auto
  # Reverse handler ports are picked from this inclusive range.
  lport_range: [4444, 4454]

execution:
  max_attempts: 5            # stop after this many candidate exploits
  delay_between_attempts: 10 # seconds to wait between attempts
  check_before_fire: true    # run module check() as a dry-run first when supported

# Preferred reverse payloads per platform/arch. The first one that is
# compatible with a given exploit module is used; otherwise a generic
# fallback is chosen from the module's compatible payload list.
payloads:
  linux_x86: linux/x86/meterpreter/reverse_tcp
  linux_x64: linux/x64/meterpreter/reverse_tcp
  windows_x86: windows/meterpreter/reverse_tcp
  windows_x64: windows/x64/meterpreter/reverse_tcp
  generic: generic/shell_reverse_tcp

recon:
  # Scan breadth. The default top-1000 silently misses a service on a high
  # port (and with it, maybe your shell), so pick how wide to look:
  #   fast       - top 100 ports (quick triage)
  #   normal     - nmap default top 1000 + version detection
  #   full       - ALL 65535 TCP ports (recommended for a real pentest)
  #   aggressive - all ports, faster timing, exhaustive version probing
  scan_profile: full
  # Set nmap_arguments to override the profile entirely with your own flags.
  # nmap_arguments: "-sV -Pn"   # -oX is added automatically for XML parsing
  timeout: 600               # seconds (raise for full/aggressive on slow links)
  os_detection: false        # append -O for an OS-family guess (needs root)
  default_scripts: false     # append -sC (nmap default NSE scripts)
  udp_scan: false            # also scan common UDP services (needs root, slow)
  udp_top_ports: 50          # how many top UDP ports when udp_scan is on

# nmap NSE vulnerability scan (part of the "vulnscan" phase). Runs the nmap
# vuln scripts over the discovered open ports; a host confirmed VULNERABLE to a
# known CVE (e.g. MS17-010) has the exact Metasploit module injected at a high
# score before the exploit phase. Needs only nmap, which is already required.
nse:
  enabled: true
  scripts: "vuln,vulners"    # nmap --script argument (vulners adds CVE mapping)
  timeout: 600               # NSE scripts are slower than a service scan
  extra_args: ""             # optional extra nmap flags (space-separated)

# SMB / Active Directory enumeration with netexec (nxc) -- the fastest path to
# a Windows shell. Anonymous/guest only here (host fingerprint, null-session
# shares, RID-brute user list); a found/Pwn3d credential is fed back and unlocks
# psexec. Password spraying stays in the credential/bruteforce phases. Skipped
# if no netexec/crackmapexec binary is installed.
smbenum:
  enabled: true
  shares: true               # list shares over a null session
  rid_brute: true            # enumerate users by cycling RIDs
  timeout: 300               # per netexec invocation (seconds)

# Active web attack-surface recon (part of the "vulnscan" phase). Drives
# external CLI tools against the target's web services and feeds what they find
# back into the attack plan (a fingerprinted product -> its exploits get
# injected). Every tool is optional: whatever is not installed is skipped.
webenum:
  enabled: true
  whatweb: true              # technology/product fingerprinting
  nuclei: true               # template-based CVE / misconfig / exposure scan
  dirscan: true              # gobuster (preferred) or ffuf content discovery
  nikto: false               # classic web-server scan (slow -> opt-in)
  max_targets: 3             # at most this many web services scanned
  timeout: 300               # per-tool wall-clock limit (seconds)
  nuclei_severity: "low,medium,high,critical"
  wordlist: /usr/share/wordlists/dirb/common.txt   # used by gobuster/ffuf

# Autonomous attack engine. The strategy builds a scored, phased plan from the
# target profile and runs it adaptively (findings feed back into the plan).
strategy:
  # Phase order. Cheap/safe intel first, loud actions last. Remove a phase to
  # skip it entirely (e.g. drop "credentials" to never try default logins).
  #   vulnscan   - active external-tool pass: NSE vuln scan + netexec SMB/AD +
  #                web recon (see the nse / smbenum / webenum sections)
  #   bruteforce - hydra credential attacks (see the bruteforce section)
  phases: [enumerate, vulnscan, bruteforce, exploit, credentials, misconfig]
  stop_on_first_shell: true  # stop the whole run once a session is verified
  allow_dangerous: false     # allow crash-prone exploits (BlueKeep, etc.) + live privesc

  # Per-phase budgets (how many modules may run in each phase).
  max_enum_modules: 14
  max_exploit_attempts: 8
  max_credential_attempts: 6
  max_misconfig_attempts: 6
  max_exploits_per_service: 6   # version-matched MSF exploits kept per service

  # Scoring weights. score = category*cat + rank*rank + version_match*vm
  #                          - noise_penalty*noise
  weights:
    category: 1.0
    rank: 1.0
    version_match: 1.0
    noise_penalty: 1.0

  # Default/weak-credential checks (lab only). These use MSF login scanners
  # with BLANK_PASSWORDS + USER_AS_PASS plus the built-in small lists.
  credentials:
    enabled: true
    stop_on_first_valid: true
    extra_users: []          # added on top of the built-in user list
    extra_passwords: []      # added on top of the built-in password list

# Hydra credential brute-force (the "bruteforce" phase). Heavier than the MSF
# login scanners above: wordlist-driven, and a hit is tried straight back
# through the MSF login module to drop a session. Skipped if hydra is absent.
bruteforce:
  enabled: true
  tasks: 8                   # hydra -t parallelism (kept modest, not a flood)
  timeout: 300               # per-service wall-clock limit (seconds)
  max_services: 6            # at most this many login services attacked
  stop_on_first_valid: true  # hydra -f: stop a service after the first valid pair
  # Optional external wordlists. When unset, the built-in user/password lists
  # (plus any strategy.credentials.extra_* below) are used.
  user_wordlist:             # e.g. /usr/share/wordlists/seclists/.../users.txt
  pass_wordlist:             # e.g. /usr/share/wordlists/rockyou.txt
  extra_users: []
  extra_passwords: []

# Post-exploitation triage, run automatically once a session is verified.
# Conservative by default: it enumerates and suggests, it does not fire local
# exploits unless auto_escalate + strategy.allow_dangerous are both on.
post_exploitation:
  enabled: true
  loot: true                 # read /etc/passwd (or /etc/shadow + hashdump if root)
  deep_loot: true            # also sweep SSH keys, histories, app config creds (Linux shell)
  privesc_suggester: true    # run post/multi/recon/local_exploit_suggester (meterpreter)
  auto_escalate: true        # meterpreter getsystem; live kernel exploits still need
                             # strategy.allow_dangerous=true
  crack_hashes: true         # offline-crack looted hashes with john (or hashcat)
  crack_wordlist: /usr/share/wordlists/rockyou.txt
  crack_timeout: 240         # seconds spent cracking before giving up

searchsploit:
  enabled: true              # include Exploit-DB matches in the report (informational)
